#!/usr/bin/bash

# Check for ALSA errors in last 2 minutes
if journalctl -u shairport-sync --no-pager --since "2 minutes ago" | grep -q "unable to open slave"; then
  echo "$(date) ALSA dmix error detected, rebooting..." | tee -a /var/log/shairport-watchdog
  /sbin/reboot
fi

# Also check for mixer control warnings as early indicator
if journalctl -u shairport-sync --no-pager --since "30 seconds ago" | grep -q "failed to find mixer control"; then
  # Give it a moment to see if ALSA errors follow
  sleep 10
  if journalctl -u shairport-sync --no-pager --since "1 minute ago" | grep -q "unable to open slave"; then
    echo "$(date) Mixer control warning followed by ALSA errors, rebooting..." | tee -a /var/log/shairport-watchdog
    /sbin/reboot
  fi
fi

# Check if the USB audio device (ALSA id USBAudio) is missing
if ! aplay -l | grep -q "^card [0-9]*: USBAudio "; then
  echo "$(date) USB Audio Device (USBAudio) missing, rebooting..." | tee -a /var/log/shairport-watchdog
  /sbin/reboot
fi
# Restart audio services that crashed and that systemd gave up restarting (nqptp died
# on 2026-10-24 and stayed down; AirPlay looked available but played nothing).
for unit in nqptp avahi-daemon shairport-sync; do
  if systemctl is-failed --quiet "$unit"; then
    echo "$(date) $unit failed, restarting" | tee -a /var/log/shairport-watchdog
    systemctl reset-failed "$unit"
    systemctl restart "$unit"
  fi
done

echo "Shairport watchdog: OK"
