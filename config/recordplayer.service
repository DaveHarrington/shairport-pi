[Unit]
Description=Audio Service

[Service]
# One sox process reads the USB line in and writes to the LineOut dmix: 60 Hz notch + noise gate.
# (Was arecord | sox | aplay until 2026-10-18; arecord's WAV stream hit 2 GB and restarted every 3h23m.)
ExecStart=/usr/bin/sox -q --buffer 32768 -t alsa -r 44100 -c 2 -b 16 plughw:USBAudio,0 -t alsa -r 44100 -c 2 -b 16 LineOut bandreject 60 .01 compand .1,.2 -inf,-50.1,-inf,-50,-50 0 -90
Restart=always
RuntimeMaxSec=1d
User=shairport-sync
Group=shairport-sync

[Install]
WantedBy=multi-user.target
